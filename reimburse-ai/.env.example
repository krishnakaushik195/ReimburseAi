# Copy to .env (or .env.local). Everything is optional for a local demo.

# Shared password for the seeded demo accounts (used on first start only; delete .data/ to reseed).
# If empty, a random password is generated into .data/demo-credentials.txt.
DEMO_PASSWORD=

# Session signing secret (32+ characters). If empty, one is generated into .data/session-secret.
SESSION_SECRET=

# --- AI extraction (optional). Without a key the agents use OCR + rule-based extraction. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Azure OpenAI takes precedence when endpoint, key and deployment are all set.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Model behind the deployment, shown in the UI (e.g. gpt-4o)
AZURE_OPENAI_MODEL=
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- PayPal Payouts (optional). Without credentials payouts are simulated. ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Required to accept webhooks at /api/webhooks/paypal (otherwise use "Sync PayPal").
PAYPAL_WEBHOOK_ID=

# --- Agent switches ---
# Set to false to stop all LLM calls without removing keys
AGENT_LLM_ENABLED=true
# Set to true to simulate payouts even when PayPal credentials are configured
AGENT_DRY_RUN=false
# Maximum PDF pages read from one uploaded document
AGENT_MAX_PAGES_PER_SOURCE=20
# Maximum claims per bulk approve/reject or PayPal sync
AGENT_MAX_DATASETS_PER_RUN=100
